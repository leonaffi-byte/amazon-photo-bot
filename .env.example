# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                # Required: Your Telegram bot token from @BotFather
TEST_BOT_TOKEN=                    # Token for testing bot (testing/evaluation only)

# Comma-separated Telegram user IDs that have admin access to /admin, /addtag etc.
# Find your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# ─── AI Vision Providers ───────────────────────────────────────────────────────
# Add keys only for the providers you have. The bot auto-detects which are available.

OPENAI_API_KEY=sk-...                       # OpenAI (gpt-4o + gpt-4o-mini)
ANTHROPIC_API_KEY=sk-ant-...               # Anthropic (claude-3-5-sonnet + claude-3-haiku)
GOOGLE_API_KEY=AIza...                     # Google (gemini-1.5-flash / 2.0-flash / 1.5-pro)
OPENROUTER_API_KEY=                        # openrouter.ai — 100+ vision models via one key

# ─── Vision Mode ──────────────────────────────────────────────────────────────
# best                  → run all providers in parallel, pick highest quality (recommended)
# cheapest              → always use cheapest available provider (gemini-flash if available)
# compare               → show all provider results side-by-side, user picks
# single:openai/gpt-4o  → force one specific provider/model
VISION_MODE=best

# ─── Per-model enable/disable ─────────────────────────────────────────────────
# All models for a provider are enabled by default when the provider key is set.
# Set any of these to "false" to skip that specific model.
ENABLE_GPT_4O_MINI=true
ENABLE_GPT_4O=true
ENABLE_CLAUDE_3_HAIKU_20240307=true
ENABLE_CLAUDE_3_5_SONNET_20241022=true
ENABLE_GEMINI_1_5_FLASH=true
ENABLE_GEMINI_2_0_FLASH=true
ENABLE_GEMINI_1_5_PRO=true

# Show cost & latency info in the bot messages (useful during dev/evaluation)
SHOW_COST_INFO=true

# ─── Amazon Search Backend ────────────────────────────────────────────────────
# auto     → uses PA-API if keys present, otherwise RapidAPI (recommended)
# rapidapi → RapidAPI only (easiest to start — no Amazon relationship required)
# paapi    → Amazon PA-API only (best data quality, but requires 3 sales first)
SEARCH_BACKEND=auto

# ─── Option A: RapidAPI — RECOMMENDED FOR NEW BOTS ───────────────────────────
# Sign up free at https://rapidapi.com
# Search for "Real-Time Amazon Data" → Subscribe (free tier = 100 searches/month)
# Copy your key from https://rapidapi.com/developer/security
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Option B: Amazon PA-API 5.0 ─────────────────────────────────────────────
# Requires: Amazon Associates account + 3 qualifying sales within 180 days
# Get keys from: https://affiliate-program.amazon.com/ → Tools → Product Advertising API
# Leave blank if using RapidAPI only
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com

# ─── Custom URL Shortener (optional) ──────────────────────────────────────────
# Leave SHORTENER_ENABLED=false to use TinyURL (free, no setup)
# Set to true + set your domain to use your own shortener with click tracking
SHORTENER_ENABLED=false
SHORTENER_BASE_URL=https://go.yourdomain.com   # your domain (no trailing slash)
SHORTENER_PORT=8080                            # port the web server listens on

# ─── Database backups ────────────────────────────────────────────────────────
BACKUP_ENABLED=true                    # set false to disable automatic backups
BACKUP_DIR=                            # custom path (default: {DATA_DIR}/backups)
BACKUP_KEEP_DAYS=7                     # delete backups older than N days
BACKUP_HOUR=3                          # local hour to run daily backup (default: 3 = 03:00)

# ─── Bot settings ─────────────────────────────────────────────────────────────
RESULTS_PER_PAGE=5
MAX_RESULTS=20
FREE_DELIVERY_THRESHOLD=49
REPORT_TIMEZONE=Asia/Jerusalem         # IANA timezone for scheduled reports
REPORT_HOUR=8                          # local hour to send daily reports (default: 8 = 08:00)

# ─── API Admin ────────────────────────────────────────────────────────────────
API_ADMIN_SECRET=                      # secret key for admin API endpoints

# ═══════════════════════════════════════════════════════════════════════════════
# MULTI-PLATFORM ADAPTERS (all optional — only Telegram is required)
# Set the token/key for any platform you want to enable.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Meta (shared across WhatsApp, Instagram, Messenger) ─────────────────────
META_APP_SECRET=                       # Meta app secret for webhook signature verification
META_VERIFY_TOKEN=                     # Shared webhook verification token for Meta platforms

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_TOKEN=                        # WhatsApp Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=             # Phone number ID from Meta Business dashboard
WHATSAPP_VERIFY_TOKEN=                 # Your custom webhook verification token for WhatsApp

# ─── Instagram (Meta Messenger API) ──────────────────────────────────────────
INSTAGRAM_TOKEN=                       # Instagram access token (from Meta Graph API)
INSTAGRAM_PAGE_ID=                     # Connected Facebook Page ID

# ─── Facebook Messenger ──────────────────────────────────────────────────────
MESSENGER_TOKEN=                       # Messenger page access token
MESSENGER_PAGE_ID=                     # Facebook Page ID
MESSENGER_VERIFY_TOKEN=                # Your custom webhook verification token for Messenger

# ─── Viber ────────────────────────────────────────────────────────────────────
VIBER_TOKEN=                           # Viber Bot API token (from https://partners.viber.com/)
VIBER_BOT_NAME=AmazonPhotoBot         # Display name for the bot in Viber
VIBER_WEBHOOK_URL=                     # Full URL for Viber webhook (e.g. https://yourdomain.com/webhook/viber)

# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=                         # Discord bot token (from https://discord.com/developers)

# ─── LINE ─────────────────────────────────────────────────────────────────────
LINE_CHANNEL_SECRET=                   # LINE channel secret (from LINE Developers console)
LINE_CHANNEL_TOKEN=                    # LINE channel access token (long-lived)

# ─── Webhook base URL ────────────────────────────────────────────────────────
# Base URL for webhook endpoints. The webhook server listens on port 8081.
# Example: https://yourdomain.com  (routes: /webhook/whatsapp, /webhook/instagram, etc.)
WEBHOOK_BASE_URL=
